# Copy this file to `.env` in this same directory (backend/.env) and fill
# in real values for local development. Never commit the real `.env` file
# -- it is already excluded in .gitignore.
#
# When running through Docker Compose instead, these same variable names
# are read from the root-level `.env` file (see ../.env.example) and
# injected into the container automatically -- you do not need both.

# --- Django core -------------------------------------------------------------
# Which settings module to boot with.
#   Local dev:   config.settings.development
#   Production:  config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# True locally. MUST be False in production (production.py forces this
# regardless of what's set here, as a safety net).
DEBUG=True

# Generate a real one for anything beyond local experimentation:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# IMPORTANT: wrap the value in double quotes if it contains characters
# the .env parser treats specially (notably '#' which starts a comment
# and would silently truncate the key):
#   SECRET_KEY="a+b#c..."
SECRET_KEY=

# Comma-separated, no spaces.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://cusin.ir,https://www.cusin.ir

# Only read by config.settings.production (irrelevant for the development
# module above). Set to True only once real HTTPS certificates are
# installed and the HTTPS block in nginx/conf.d/cusin.conf is uncommented
# -- see config/settings/production.py for exactly what this controls.
HTTPS_ENABLED=False

# --- Database ------------------------------------------------------------------
# Preferred: a single connection URL -- postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://cusin_user:cusin_password@localhost:5432/cusin_gallery

# Fallback if DATABASE_URL is unset (used as-is by docker-compose, where
# each part is already its own service variable):
POSTGRES_DB=cusin_gallery
POSTGRES_USER=cusin_user
POSTGRES_PASSWORD=cusin_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS ------------------------------------------------------------------------
# Comma-separated origins the frontend is served from. Full origins only
# (scheme + host [+ port]), no paths, no trailing slash. Required (non-empty)
# in production -- see config/settings/production.py.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used only to build absolute links in backend-generated content (e.g.
# the password-reset email) -- see config/settings/base.py.
FRONTEND_URL=http://localhost:5173

# Shipping (Phase 6, methods + delivery windows added in Phase A) --
# all costs are whole Toman, all windows are calendar days. Orders
# snapshot these values at checkout; changing them never rewrites
# existing orders. See apps/orders/shipping.py.
STANDARD_SHIPPING_COST=50000
FREE_SHIPPING_THRESHOLD=1000000
SHIPPING_MIN_DELIVERY_DAYS=3
SHIPPING_MAX_DELIVERY_DAYS=5
EXPRESS_SHIPPING_COST=90000

# Gift wrapping (Part 2): whole-Toman fee added to the order total when
# the shopper opts in at checkout (message max 200 chars, plain text).
# 0 = the option is hidden entirely. By documented decision the fee
# does NOT count toward the free-shipping threshold and coupons do not
# discount it (both are computed on the product subtotal).
GIFT_WRAP_FEE=0

# Selectable methods at checkout (Part 1): "standard" (عادی, cost + free
# threshold + window above), "express" (اکسپرس, EXPRESS_SHIPPING_COST,
# never free, always exactly 1-day delivery), and "pickup" (حضوری,
# always free, no courier and no delivery address -- the store's pickup
# address/hours come from «تنظیمات فروشگاه» in the admin panel, and
# "shipped" for pickup orders means "ready for pickup").
# Method keys are part of order snapshots: never rename them.

# Shared cache (production only -- see config/settings/production.py).
# Must point at ONE Redis instance all gunicorn workers share, so DRF
# throttle counters are global rather than per-worker. The default
# matches the redis service in docker-compose.yml; dev/test ignore this
# and use in-process LocMem.
REDIS_URL=redis://redis:6379/1

# --- Email -------------------------------------------------------------------------
# Left blank in development (console backend is used instead, see
# config/settings/development.py). Required for real delivery in production.
# Also used by the Phase D email notifications (order confirmation,
# shipped notice, password-reset links) for accounts that have an email;
# with the production SMTP backend selected but EMAIL_HOST empty, those
# emails are recorded as SKIPPED in the notification log instead of
# failing every time.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@cusin.ir

# --- Payment gateway (Phase C - real payments) ----------------------------------
# Which gateway implementation handles payments (apps/payments/gateways):
#   mock     = self-contained test gateway for LOCAL DEVELOPMENT (default
#              here). The production settings module refuses to start with
#              it, so it can never leak into production.
#   zarinpal = the real ZarinPal PSP -- use with PAYMENT_ZARINPAL_SANDBOX
#              below for testing, and with the real merchant id for live.
PAYMENT_GATEWAY=mock

# ZarinPal merchant id: the 36-character code from your ZarinPal merchant
# panel. REQUIRED when PAYMENT_GATEWAY=zarinpal in production. In sandbox
# mode any 36-character value works (e.g. an all-zeros UUID). With the
# mock gateway this same variable is its callback-signing secret (leave
# empty locally and the mock falls back to SECRET_KEY). Never commit a
# real value.
PAYMENT_MERCHANT_ID=

# ZarinPal mode switch: True = sandbox (sandbox.zarinpal.com, no real
# money), False = production (api.zarinpal.com, real money). Only read
# when PAYMENT_GATEWAY=zarinpal.
PAYMENT_ZARINPAL_SANDBOX=True

# Where the gateway sends the customer's browser back after payment. Must
# point at THIS backend and be reachable by the customer's browser. For
# local development with the mock gateway any localhost URL works; for
# ZarinPal sandbox testing the backend must be reachable from the public
# internet (tunnel it) or tested on a staging server.
PAYMENT_CALLBACK_URL=http://localhost:8000/payment/callback/

# Seconds to wait for a ZarinPal API call (payment request / verify)
# before treating the gateway as unreachable.
PAYMENT_GATEWAY_TIMEOUT=15

# Abandoned-order cleanup: `manage.py expire_unpaid_orders` (cron) cancels
# UNPAID orders older than this many hours. No stock moves for unpaid
# orders, so this is pure hygiene; repeated runs are safe.
ORDER_EXPIRY_HOURS=24

# --- Notifications / SMS (Phase D) ------------------------------------------------
# Customer notifications: order confirmation (after payment), "shipped"
# with the tracking code, and one-time password-reset codes for phone-only
# accounts. Delivery failures NEVER break checkout/payment/admin actions
# and every attempt is recorded in the admin's «گزارش اعلان‌ها» log.
#
# Master switch. False = no SMS is ever sent; phone-only password resets
# then record a SKIPPED notification.
SMS_ENABLED=True

# SMS provider:
#   console   = log-only, LOCAL DEVELOPMENT/TESTS (default here; emails
#               print to console the same way). Production settings REFUSE
#               to boot with it while SMS_ENABLED=True.
#   kavenegar = the real Kavenegar provider -- set the variables below.
SMS_PROVIDER=console

# Kavenegar account API key (https://panel.kavenegar.com). SECRET -- never
# commit a real value. Required when SMS_PROVIDER=kavenegar.
KAVENEGAR_API_KEY=

# Kavenegar sender line number (e.g. 1000xxxx) -- required for DIRECT text
# sends; template sends below work without it.
SMS_SENDER=

# Pre-approved Kavenegar panel template names (verify-lookup), one per
# event. Leave EMPTY to fall back to a direct send with the built-in
# Persian text (which then needs SMS_SENDER above).
#   password reset code template receives: token = the 6-digit code
#   order confirmed template receives:     token = order number, token2 = total (Toman)
#   order shipped template receives:       token = order number, token2 = tracking code
SMS_TEMPLATE_PASSWORD_RESET=
SMS_TEMPLATE_ORDER_CONFIRMED=
SMS_TEMPLATE_ORDER_SHIPPED=

# Seconds to wait for an SMS provider HTTP call before treating it as
# unreachable (failures are logged, never user-facing).
SMS_TIMEOUT=10

# Validity window (minutes) of one-time password-reset codes sent by SMS.
# Codes are single-use and hashed at rest; the confirm endpoint is
# rate-limited (10/hour).
PASSWORD_RESET_CODE_TTL_MINUTES=15

# --- Logging & monitoring -----------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# Log output shape: "plain" (default, human-readable -- right for local
# development) or "json" (one structured JSON object per line on stdout;
# production deployments set this -- see config/json_logging.py).
LOG_FORMAT=plain

# Error monitoring (optional): paste a sentry.io project DSN to enable
# reporting of unhandled exceptions; empty = off. The sentry-sdk package
# is already in requirements.txt, so enabling is an env change only.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Analytics (Part 4, optional) ----------------------------------------------
# Privacy-friendly usage stats. Leave BOTH empty and NOTHING loads (no
# request, no cookies). When set, the storefront SPA loads the script
# (Plausible/Matomo-compatible), respects Do Not Track, and the Django
# admin + payment callback pages never include it. Google Analytics and
# similar are often unreliable from Iran -- prefer self-hosted Plausible
# or Matomo (see docs/DEPLOY.md).
ANALYTICS_SCRIPT_URL=
ANALYTICS_SITE_ID=

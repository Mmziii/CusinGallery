# Root-level environment file, used by docker-compose.yml both to
# interpolate values into the compose file itself (e.g. ${POSTGRES_DB})
# and to inject them into the backend/db/frontend-build containers.
#
# Copy this file to `.env` in the repository root before running
# `docker compose up`. Never commit the real `.env` -- see .gitignore.
#
# This intentionally duplicates the shape of backend/.env.example and
# frontend/.env.example: those two are for running each half of the app
# directly on your machine without Docker; this one is for Docker Compose.
# Keep the variable NAMES identical across all three so nothing silently
# diverges between the two ways of running the project.

# --- Django core -------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=

ALLOWED_HOSTS=cusin.ir,www.cusin.ir
CSRF_TRUSTED_ORIGINS=https://cusin.ir,https://www.cusin.ir
CORS_ALLOWED_ORIGINS=https://cusin.ir,https://www.cusin.ir

# Used only to build absolute links in backend-generated content (e.g.
# the password-reset email) -- see config/settings/base.py.
FRONTEND_URL=https://cusin.ir

# Shipping (Phase 6, methods + delivery windows added in Phase A) --
# all costs are whole Toman, all windows are calendar days. Orders
# snapshot these values at checkout; changing them never rewrites
# existing orders. See apps/orders/shipping.py.
STANDARD_SHIPPING_COST=50000
FREE_SHIPPING_THRESHOLD=1000000
SHIPPING_MIN_DELIVERY_DAYS=3
SHIPPING_MAX_DELIVERY_DAYS=5
EXPRESS_SHIPPING_COST=90000
EXPRESS_MIN_DELIVERY_DAYS=1
EXPRESS_MAX_DELIVERY_DAYS=2

# Shared cache (production only -- see config/settings/production.py).
# Must point at ONE Redis instance all gunicorn workers share, so DRF
# throttle counters are global rather than per-worker. The default
# matches the redis service in docker-compose.yml; dev/test ignore this
# and use in-process LocMem.
REDIS_URL=redis://redis:6379/1

# Set to True only after real HTTPS certificates are installed and the
# HTTPS server block in nginx/conf.d/cusin.conf is uncommented. Until then,
# keep this False -- see config/settings/production.py for exactly what it
# controls (SSL redirect, secure-only cookies, HSTS). Leaving it False with
# no HTTPS configured is a normal, working state, not a misconfiguration.
HTTPS_ENABLED=False

# --- Database (consumed by both the `db` service and the backend's
# DATABASE_URL-less fallback config, see config/settings/base.py) -----------
POSTGRES_DB=cusin_gallery
POSTGRES_USER=cusin_user
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Email -------------------------------------------------------------------
# Real SMTP delivery in production. Also used by the Phase D email
# notifications (order confirmation, shipped notice, password-reset
# links) for accounts that have an email; with EMAIL_HOST empty those
# emails are recorded as SKIPPED in the notification log instead of
# failing every time.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@cusin.ir

# --- Payment gateway (Phase C - real payments) --------------------------------
# Which gateway implementation handles payments (apps/payments/gateways):
#   zarinpal = the real ZarinPal PSP (production AND its sandbox test mode)
#   mock     = development/testing ONLY -- the production settings module
#              REFUSES to start with it (or with this variable empty),
#              so it is impossible to enable in production.
PAYMENT_GATEWAY=zarinpal

# ZarinPal merchant id: the 36-character code from your ZarinPal merchant
# panel. REQUIRED in production (the backend refuses to start without it).
# For sandbox testing (below) ZarinPal accepts ANY 36-character value,
# e.g. 00000000-0000-0000-0000-000000000000. Never commit the real value.
PAYMENT_MERCHANT_ID=

# ZarinPal mode switch:
#   True  = sandbox (sandbox.zarinpal.com): full test mode, no real money.
#           Use this to test the whole flow before going live.
#   False = production (api.zarinpal.com / www.zarinpal.com): real money.
PAYMENT_ZARINPAL_SANDBOX=False

# Where ZarinPal sends the customer's browser back after payment. Must be
# THIS backend, publicly reachable, and the same domain you register in
# the ZarinPal merchant panel. The backend serves this path at both
# /payment/callback/ and /api/v1/payments/callback/ (identical view).
PAYMENT_CALLBACK_URL=https://cusin.ir/payment/callback/

# Seconds to wait for a ZarinPal API call (payment request / verify)
# before treating the gateway as unreachable.
PAYMENT_GATEWAY_TIMEOUT=15

# Abandoned-order cleanup: `manage.py expire_unpaid_orders` (point cron at
# it, e.g. hourly -- see docs/PAYMENTS.md) cancels UNPAID orders older
# than this many hours. No stock moves for unpaid orders, so this is pure
# hygiene; repeated runs are safe.
ORDER_EXPIRY_HOURS=24

# --- Notifications / SMS (Phase D) ---------------------------------------------
# Customer notifications: order confirmation (after payment), "shipped"
# with the tracking code, and one-time password-reset codes for phone-only
# accounts. Delivery failures NEVER break checkout/payment/admin actions
# and every attempt is recorded in the admin's «گزارش اعلان‌ها» log.
#
# Master switch. False = no SMS is ever sent (production may then run
# without a provider); phone-only password resets record a SKIPPED
# notification. True (default) requires a REAL provider in production --
# the backend refuses to start with the console provider enabled.
SMS_ENABLED=True

# SMS provider: kavenegar (real) | console (log-only, dev/test ONLY --
# production settings refuse to boot with it while SMS_ENABLED=True).
# Adding another provider later = one new class + one registry line
# (apps/notifications/providers/).
SMS_PROVIDER=kavenegar

# Kavenegar account API key (https://panel.kavenegar.com). SECRET --
# never commit the real value. Required when SMS_PROVIDER=kavenegar and
# SMS_ENABLED=True (production refuses to boot without it).
KAVENEGAR_API_KEY=

# Kavenegar sender line number (e.g. 1000xxxx) -- required for DIRECT
# text sends; template sends below work without it.
SMS_SENDER=

# Pre-approved Kavenegar panel template names (verify-lookup), one per
# event. Leave a value EMPTY to fall back to a direct send with the
# built-in Persian text (which then needs SMS_SENDER above).
#   password reset code template receives: token = the 6-digit code
#   order confirmed template receives:     token = order number, token2 = total (Toman)
#   order shipped template receives:       token = order number, token2 = tracking code
SMS_TEMPLATE_PASSWORD_RESET=
SMS_TEMPLATE_ORDER_CONFIRMED=
SMS_TEMPLATE_ORDER_SHIPPED=

# Seconds to wait for an SMS provider HTTP call before treating it as
# unreachable (failures are logged, never user-facing).
SMS_TIMEOUT=10

# Validity window (minutes) of one-time password-reset codes sent by SMS.
# Codes are single-use and hashed at rest; the confirm endpoint is
# rate-limited (10/hour).
PASSWORD_RESET_CODE_TTL_MINUTES=15

# --- Logging -----------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# --- Frontend build-time variable ---------------------------------------------
# Consumed as a Docker build ARG (see docker-compose.yml + docker/frontend/Dockerfile).
# Vite inlines this at BUILD time, so changing it requires rebuilding the
# frontend image, not just restarting the container.
# Keep it SAME-ORIGIN ("/api/v1"): nginx routes /api/ to the backend, so
# the browser talks to one origin only -- session cookies and CSRF need no
# cross-origin configuration at all.
VITE_API_BASE_URL=/api/v1

# Root-level environment file, used by docker-compose.yml both to
# interpolate values into the compose file itself (e.g. ${POSTGRES_DB})
# and to inject them into the backend/db/frontend-build containers.
#
# Copy this file to `.env` in the repository root before running
# `docker compose up`. Never commit the real `.env` -- see .gitignore.
#
# This intentionally duplicates the shape of backend/.env.example and
# frontend/.env.example: those two are for running each half of the app
# directly on your machine without Docker; this one is for Docker Compose.
# Keep the variable NAMES identical across all three so nothing silently
# diverges between the two ways of running the project.

# --- Django core -------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=

ALLOWED_HOSTS=cusin.ir,www.cusin.ir
CSRF_TRUSTED_ORIGINS=https://cusin.ir,https://www.cusin.ir
CORS_ALLOWED_ORIGINS=https://cusin.ir,https://www.cusin.ir

# Used only to build absolute links in backend-generated content (e.g.
# the password-reset email) -- see config/settings/base.py.
FRONTEND_URL=https://cusin.ir

# Shipping (Phase 6) -- whole-Toman flat rate, and the subtotal at or
# above which shipping becomes free. See apps/orders/shipping.py.
STANDARD_SHIPPING_COST=50000
FREE_SHIPPING_THRESHOLD=1000000

# Set to True only after real HTTPS certificates are installed and the
# HTTPS server block in nginx/conf.d/cusin.conf is uncommented. Until then,
# keep this False -- see config/settings/production.py for exactly what it
# controls (SSL redirect, secure-only cookies, HSTS). Leaving it False with
# no HTTPS configured is a normal, working state, not a misconfiguration.
HTTPS_ENABLED=False

# --- Database (consumed by both the `db` service and the backend's
# DATABASE_URL-less fallback config, see config/settings/base.py) -----------
POSTGRES_DB=cusin_gallery
POSTGRES_USER=cusin_user
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Email -------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@cusin.ir

# --- Payment gateway (placeholder only -- see apps/payments, Phase 7) --------
PAYMENT_GATEWAY=
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=https://cusin.ir/payment/callback/

# --- Logging -----------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# --- Frontend build-time variable ---------------------------------------------
# Consumed as a Docker build ARG (see docker-compose.yml + docker/frontend/Dockerfile).
# Vite inlines this at BUILD time, so changing it requires rebuilding the
# frontend image, not just restarting the container.
VITE_API_BASE_URL=https://cusin.ir/api/v1

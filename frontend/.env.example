# Copy to `.env` in this same directory for local development.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Base URL the frontend calls for the API.
#   Local dev (Django running directly):        http://localhost:8000/api/v1
#   Local dev (through docker-compose/Nginx):    http://localhost/api/v1
#   Production:                                   https://cusin.ir/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

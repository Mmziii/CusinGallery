# Copy to `.env` in this same directory for local development.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Base URL the frontend calls for the API.
#
#   Recommended default (leave UNSET): the apiClient falls back to the
#   same-origin relative path "/api/v1". In `npm run dev` the Vite dev
#   server proxies /api/ to Django (see vite.config.js), and in Docker
#   nginx proxies /api/ to the backend -- either way the browser only
#   ever talks to one origin, so session cookies and CSRF need no
#   cross-origin configuration.
#
#   Only set an absolute URL if the API genuinely lives on another
#   origin (then CORS_ALLOWED_ORIGINS on the backend must cover it):
#     VITE_API_BASE_URL=https://api.example.com/api/v1

# Canonical public origin of the storefront (Phase E, SEO). Used by
# src/hooks/usePageMeta.js to build absolute <link rel="canonical"> and
# og:url values. Build-time variable (like VITE_API_BASE_URL): changing
# it requires a rebuild. Leave UNSET for the default https://cusin.ir;
# staging deployments set their own origin.
#   VITE_SITE_ORIGIN=https://cusin.ir

# --- Error reporting (Part S3, optional) ---------------------------------------
# Frontend error reports (ErrorBoundary crashes) are forwarded to the
# BACKEND's existing Sentry setup through POST /api/v1/site/report-error/
# -- the storefront itself ships NO Sentry SDK. Set this to any non-empty
# value (a copy of the backend SENTRY_DSN is fine) to ENABLE reporting;
# leave it EMPTY and the browser never sends a single report. Reports are
# only captured into Sentry when the backend's own SENTRY_DSN is also set;
# otherwise they are kept in the server log.
VITE_SENTRY_DSN=

# --- Analytics (Part 4, optional) ----------------------------------------------
# Privacy-friendly usage stats. Leave BOTH empty and NOTHING loads (no
# request, no cookies). When set, the storefront SPA loads the script
# (Plausible/Matomo-compatible), respects Do Not Track, and the Django
# admin + payment callback pages never include it. Google Analytics and
# similar are often unreliable from Iran -- prefer self-hosted Plausible
# or Matomo (see docs/DEPLOY.md).
ANALYTICS_SCRIPT_URL=
ANALYTICS_SITE_ID=
